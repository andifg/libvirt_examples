{# libvirt_network_type: isolated → L2 only. Anything else → forward + host IPv4 (DHCP optional) + optional IPv6. #}
{# Order matches libvirt default networks: forward before bridge when NAT is used (some versions are picky). #}
{% set _type = libvirt_network_type | default('nat') | string | trim | lower %}
<network>
  <name>{{ libvirt_network_name }}</name>
{% if _type == 'isolated' %}
  <bridge name="{{ libvirt_network_bridge }}" stp="on" delay="0"/>
{% else %}
{% set _fwd = libvirt_network_forward_mode | default('nat') | string | trim | lower %}
{% if _fwd == 'nat' %}
  <forward mode="nat">
    <nat>
      <port start="1024" end="65535"/>
    </nat>
  </forward>
{% else %}
  <forward mode="{{ libvirt_network_forward_mode }}"/>
{% endif %}
  <bridge name="{{ libvirt_network_bridge }}" stp="on" delay="0"/>
  <ip address="{{ libvirt_network_ip_address }}" netmask="{{ libvirt_network_ip_netmask }}">
{% if libvirt_network_dhcp_enabled %}
    <dhcp>
      <range start="{{ libvirt_network_dhcp_range_start }}" end="{{ libvirt_network_dhcp_range_end }}"/>
{% for h in libvirt_network_dhcp_hosts | default([]) %}
      <host mac="{{ h.mac }}" ip="{{ h.ip }}"/>
{% endfor %}
    </dhcp>
{% endif %}
  </ip>
{% if libvirt_network_ipv6_enabled %}
  <ip family="ipv6" address="{{ libvirt_network_ipv6_address }}" prefix="{{ libvirt_network_ipv6_prefix }}"/>
{% endif %}
{% endif %}
</network>
